# Copiá este archivo a ".env" (misma carpeta que db.js) y completá con tus datos reales.
# El .env real NUNCA se sube al repositorio (ya está en .gitignore).

# Correo de Gmail que va a ENVIAR los mails de recuperación
EMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación de 16 caracteres (NO tu contraseña normal de Gmail)
# Se genera en: Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
EMAIL_PASS=xxxx xxxx xxxx xxxx

# URL donde corre tu frontend de React (para armar el link del correo)
FRONTEND_URL=http://localhost:3001

# Secreto para firmar los JWT (generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Conexión a MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=padel

# Mercado Pago (credenciales de TEST, nunca de producción en desarrollo)
# Se consiguen en https://www.mercadopago.com.ar/developers/panel -> tu app -> Credenciales de prueba
MP_ACCESS_TOKEN=

# Opcional: URL pública para el webhook de pagos (requiere ngrok o similar en local)
MP_WEBHOOK_URL=
